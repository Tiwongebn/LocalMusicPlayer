    margin-bottom: 10px;
}

.add-folder {
    display: flex;

    gap: 10px;

    max-width: 700px;

    margin-top: 25px;
}

.add-folder input {
    flex: 1;

    padding: 12px 15px;

    border: 1px solid #333;

    border-radius: 7px;

    background: #181818;

    color: white;

    outline: none;
}

.add-folder input:focus {
    border-color: #555;
}

.settings-section button {
    padding: 10px 16px;

    border: none;

    border-radius: 6px;

    background: #303030;

    color: white;
}

.settings-section button:hover {
    background: #404040;
}

.folder-list {
    display: flex;

    flex-direction: column;

    gap: 10px;

    max-width: 900px;

    margin-top: 25px;
}

.folder-item {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;

    padding: 15px 18px;

    background: #1c1c1c;

    border: 1px solid #292929;

    border-radius: 8px;
}

.folder-item > div:first-child {
    display: flex;

    flex-direction: column;

    min-width: 0;
}

.folder-item strong {
    margin-bottom: 5px;
}

.folder-item span {
    overflow: hidden;

    color: #888;

    text-overflow: ellipsis;

    white-space: nowrap;
}

.folder-item > div:last-child {
    display: flex;

    flex-shrink: 0;

    gap: 8px;
}
