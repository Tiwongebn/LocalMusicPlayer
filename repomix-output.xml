<file path="backend/Controllers/MusicFolderController.cs">
using backend.Data;
using backend.DTOs;
using backend.Models;
using backend.Services;
using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;

namespace backend.Controllers;

[ApiController]
[Route("api/[controller]")]
public class MusicFoldersController : ControllerBase
{
    private readonly MusicDbContext _context;

    private readonly MusicLibraryScanner _scanner;

    public MusicFoldersController(
    MusicDbContext context,
    MusicLibraryScanner scanner)
{
    _context = context;

    _scanner = scanner;
}

    [HttpGet]
    public async Task<IActionResult> GetFolders()
    {
        var folders = await _context.MusicFolders
            .OrderBy(folder => folder.Name)
            .ToListAsync();

        return Ok(folders);
    }

    [HttpPost]
    public async Task<IActionResult> AddFolder(
        [FromBody] AddMusicFolderRequest request)
    {
        if (string.IsNullOrWhiteSpace(request.FolderPath))
        {
            return BadRequest(new
            {
                message = "Folder path is required."
            });
        }

        var fullPath = Path.GetFullPath(
            request.FolderPath);

        if (!Directory.Exists(fullPath))
        {
            return NotFound(new
            {
                message = "The specified folder does not exist."
            });
        }

        var alreadyExists =
            await _context.MusicFolders
                .AnyAsync(folder =>
                    folder.Path == fullPath);

        if (alreadyExists)
        {
            return Conflict(new
            {
                message = "This folder is already in your library."
            });
        }

        var folder = new MusicFolder
        {
            Path = fullPath,

            Name = new DirectoryInfo(fullPath).Name,

            DateAdded = DateTime.UtcNow
        };

        _context.MusicFolders.Add(folder);

        await _context.SaveChangesAsync();

        return CreatedAtAction(
            nameof(GetFolder),
            new { id = folder.Id },
            folder);
    }

    [HttpGet("{id:int}")]
    public async Task<IActionResult> GetFolder(int id)
    {
        var folder = await _context.MusicFolders
            .FindAsync(id);

        if (folder == null)
        {
            return NotFound();
        }

        return Ok(folder);
    }

    [HttpDelete("{id:int}")]
    public async Task<IActionResult> DeleteFolder(int id)
    {
        var folder = await _context.MusicFolders
            .FindAsync(id);

        if (folder == null)
        {
            return NotFound();
        }

        _context.MusicFolders.Remove(folder);

        await _context.SaveChangesAsync();

        return NoContent();
    }

    [HttpPost("{id:int}/scan")]
public async Task<IActionResult> ScanFolder(int id)
{
    var folder =
        await _context.MusicFolders
            .FindAsync(id);

    if (folder == null)
    {
        return NotFound(new
        {
            message = "Music folder not found."
        });
    }

    try
    {
        var imported =
            await _scanner.ScanFolderAsync(folder);

        return Ok(new
        {
            message = "Folder scan completed.",

            importedCount = imported,

            lastScanned = folder.LastScanned
        });
    }
    catch (DirectoryNotFoundException)
    {
        return NotFound(new
        {
            message =
                "The folder no longer exists."
        });
    }
}

[HttpPost("cleanup")]
public async Task<IActionResult> CleanupLibrary()
{
    var removed =
        await _scanner.RemoveMissingFilesAsync();

    return Ok(new
    {
        message = "Library cleanup completed.",

        removedCount = removed
    });
}
}
</file>

<file path="backend/Controllers/SongsController.cs">
using backend.Data;
using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;

namespace backend.Controllers;

[ApiController]
[Route("api/[controller]")]
public class SongsController : ControllerBase
{
    private readonly MusicDbContext _context;

    public SongsController(MusicDbContext context)
    {
        _context = context;
    }

    [HttpGet]
    public async Task<IActionResult> GetSongs()
    {
        var songs = await _context.Songs
            .OrderBy(song => song.Artist)
            .ThenBy(song => song.Album)
            .ThenBy(song => song.TrackNumber)
            .ToListAsync();

        return Ok(songs);
    }

    [HttpGet("{id:int}")]
    public async Task<IActionResult> GetSong(int id)
    {
        var song = await _context.Songs
            .FirstOrDefaultAsync(song => song.Id == id);

        if (song == null)
        {
            return NotFound();
        }

        return Ok(song);
    }

    [HttpGet("{id:int}/stream")]
    public async Task<IActionResult> StreamSong(int id)
    {
        var song = await _context.Songs
            .FirstOrDefaultAsync(song => song.Id == id);

        if (song == null)
        {
            return NotFound(new
            {
                message = "Song not found."
            });
        }

        if (!System.IO.File.Exists(song.FilePath))
        {
            return NotFound(new
            {
                message = "Music file no longer exists."
            });
        }

        var contentType = GetContentType(song.FilePath);

        var stream = new FileStream(
            song.FilePath,
            FileMode.Open,
            FileAccess.Read,
            FileShare.Read);

        return File(
            stream,
            contentType,
            enableRangeProcessing: true);
    }

    private static string GetContentType(string filePath)
    {
        var extension = Path.GetExtension(filePath)
            .ToLowerInvariant();

        return extension switch
        {
            ".mp3" => "audio/mpeg",
            ".wav" => "audio/wav",
            ".flac" => "audio/flac",
            ".m4a" => "audio/mp4",
            ".aac" => "audio/aac",
            ".ogg" => "audio/ogg",
            ".opus" => "audio/ogg",
            _ => "application/octet-stream"
        };
    }
}
